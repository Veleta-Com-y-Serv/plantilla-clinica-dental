---
// Apartado de texto genérico: banda de cielo pálido con antetítulo, título con sonrisa, párrafos, lista con icono y
// botón. Con imagen, banda partida 50/50 con la foto a sangre hasta el borde derecho de la ventana.
// Lo usan los apartados nuevos que pide el cliente (site.yaml: `tipo: texto`).
import { seccion, parrafos } from '../../data/site';
import { altSeccion } from '../../lib/seo';
import Seccion from '../ui/Seccion.astro';
import Titular from '../ui/Titular.astro';
import Imagen from '../ui/Imagen.astro';
import Icono from '../ui/Icono.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const items = s ? s.items.filter((it) => it?.titulo) : [];
---

{
  s && (
    <Seccion id={Astro.props.id} tono="cielo" contenedor={false}>
      <div class:list={['texto-fila', { 'texto-fila--sin-foto': !s.imagen }]}>
        <div class="texto-cuerpo">
          <Titular antetitulo={s.antetitulo} titulo={s.titulo} class="!mb-0" />
          <div class:list={['mt-6 grid gap-x-12 gap-y-4 text-[1.08rem] opacity-85', { 'lg:grid-cols-2': !s.imagen }]}>
            {parrafos(s.texto).map((p) => <p>{p}</p>)}
          </div>
          {items.length > 0 && (
            <ul class:list={['mt-9 grid gap-5', { 'md:grid-cols-2 lg:grid-cols-4': !s.imagen, 'sm:grid-cols-2': s.imagen }]}>
              {items.map((it) => (
                <li class="flex gap-4">
                  <span class="icono-caja"><Icono nombre={it.icono} tam={22} /></span>
                  <div>
                    <p class="font-extrabold">{it.titulo}</p>
                    {it.texto && <p class="text-sm opacity-75">{it.texto}</p>}
                  </div>
                </li>
              ))}
            </ul>
          )}
          {s.cta?.url && <a class="btn mt-10" href={s.cta.url}>{s.cta.texto}</a>}
        </div>
        {s.imagen && (
          <div class="texto-foto">
            <Imagen src={s.imagen} alt={altSeccion(s)} ancho={1200} alto={1000} class="h-full w-full object-cover" />
          </div>
        )}
      </div>
    </Seccion>
  )
}

<style>
  .texto-fila { display: grid; grid-template-columns: minmax(0, 1fr); gap: 2.75rem; }
  .texto-cuerpo { padding-inline: 1rem; }
  .texto-foto { overflow: hidden; aspect-ratio: 4 / 3; margin-bottom: calc(-1 * var(--pad)); }
  @media (min-width: 768px) { .texto-cuerpo { width: 100%; max-width: var(--ancho); margin-inline: auto; padding-inline: 2rem; } }
  @media (min-width: 1024px) {
    .texto-fila:not(.texto-fila--sin-foto) { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: center; gap: clamp(3rem, 6vw, 6rem); }
    .texto-fila:not(.texto-fila--sin-foto) .texto-cuerpo { max-width: none; padding-right: 0; padding-left: max(2rem, calc((100vw - var(--ancho)) / 2 + 2rem)); }
    .texto-foto { align-self: stretch; aspect-ratio: auto; min-height: 30rem; margin-top: calc(-1 * var(--pad)); }
  }
</style>
