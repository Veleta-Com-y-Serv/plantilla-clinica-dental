---
// Pedir cita: banda menta pálida partida 50/50. A la izquierda, la foto (`imagen`) a sangre hasta los bordes de
// arriba, izquierda y abajo. A la derecha, titular, pasos numerados en fila (`items` {titulo}), el formulario en un
// panel blanco con tratamiento (`opciones`: «Revisión; Limpieza; …») y franja horaria (`franjas`: «Mañana; Tarde»)
// y los atajos de WhatsApp (`cta.texto`; destino `cta.url` o, si está vacío, el WhatsApp de contacto) y teléfono.
// Sin foto, el formulario ocupa todo el ancho.
import { seccion, site, tel, whatsapp } from '../../data/site';
import { altSeccion } from '../../lib/seo';
import Seccion from '../ui/Seccion.astro';
import Titular from '../ui/Titular.astro';
import Imagen from '../ui/Imagen.astro';
import Icono from '../ui/Icono.astro';
import FormularioCita from '../ui/FormularioCita.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const c = site.contacto;
const pasos = s ? s.items.filter((it) => it?.titulo) : [];
const destinoWa = s?.cta?.url || whatsapp(c.whatsapp, 'Hola, quiero pedir cita');
const textoWa = s?.cta?.texto || '';
---

{
  s && (
    <Seccion id={Astro.props.id} tono="menta" contenedor={false}>
      <div class:list={['cita-fila', { 'cita-fila--sin-foto': !s.imagen }]}>
        {s.imagen && (
          <div class="cita-foto">
            <Imagen src={s.imagen} alt={altSeccion(s)} ancho={1200} alto={1500} class="h-full w-full object-cover" />
          </div>
        )}
        <div class="cita-cuerpo">
          <Titular antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} class="!mb-0" />
          {pasos.length > 0 && (
            <ol class="cita-pasos">
              {pasos.map((p, i) => (
                <li class="flex items-center gap-3 font-bold">
                  <span class="cita-paso-num">{i + 1}</span>
                  {p.titulo}
                </li>
              ))}
            </ol>
          )}
          <div class="cita-panel">
            <FormularioCita opciones={String(s.opciones ?? '')} franjas={String(s.franjas ?? '')} />
          </div>
          {((destinoWa && textoWa) || c.telefono) && (
            <div class="mt-6 flex flex-wrap gap-3">
              {destinoWa && textoWa && (
                <a href={destinoWa} rel="noopener" target="_blank" class="btn-sec">
                  <Icono nombre="whatsapp" tam={20} /> {textoWa}
                </a>
              )}
              {c.telefono && (
                <a href={tel(c.telefono)} class="btn-sec">
                  <Icono nombre="telefono" tam={18} /> {c.telefono}
                </a>
              )}
            </div>
          )}
        </div>
      </div>
    </Seccion>
  )
}

<style>
  .cita-fila { display: grid; grid-template-columns: minmax(0, 1fr); gap: 2.75rem; }
  .cita-cuerpo { padding-inline: 1rem; }
  .cita-pasos { display: flex; flex-wrap: wrap; gap: .75rem 1.75rem; margin-top: 2rem; }
  .cita-paso-num { display: grid; place-items: center; flex: none; width: 2.2rem; height: 2.2rem; border-radius: .65rem; background: var(--c-primario); color: #fff; font-weight: 800; }
  .cita-panel { margin-top: 2rem; padding: clamp(1.25rem, 3vw, 2.25rem); border-radius: var(--radio); background: var(--c-fondo); box-shadow: 0 30px 60px -40px color-mix(in srgb, var(--noche) 70%, transparent); }
  .cita-foto { overflow: hidden; margin-top: calc(-1 * var(--pad)); aspect-ratio: 4 / 3; }
  @media (min-width: 640px) and (max-width: 1023px) { .cita-foto { aspect-ratio: 16 / 9; } }
  @media (min-width: 768px) { .cita-cuerpo { width: 100%; max-width: var(--ancho); margin-inline: auto; padding-inline: 2rem; } }
  @media (min-width: 1024px) {
    .cita-fila:not(.cita-fila--sin-foto) { grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: clamp(3rem, 6vw, 6rem); }
    .cita-fila:not(.cita-fila--sin-foto) .cita-cuerpo { max-width: none; padding-left: 0; padding-right: max(2rem, calc((100vw - var(--ancho)) / 2 + 2rem)); }
    .cita-foto { align-self: stretch; aspect-ratio: auto; min-height: 40rem; margin-bottom: calc(-1 * var(--pad)); }
  }
</style>
