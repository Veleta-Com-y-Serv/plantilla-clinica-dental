const cuerpo = iconos[nombre] ?? iconos.check;
---

<svg
  class={clase}
  width={tam}
  height={tam}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={cuerpo}
/>
