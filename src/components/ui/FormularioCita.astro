---
// Formulario de cita sin servidor: abre el programa de correo (mailto) con el email de site.yaml.
// Pide el tratamiento (desplegable con `opciones`, separadas por «;» o comas; sin opciones, campo de texto) y la
// franja horaria (`franjas`, botones de radio; sin franjas, no se pregunta). Si no hay email, se queda como muestra.
import { site } from '../../data/site';
interface Props { opciones?: string; franjas?: string; boton?: string; class?: string }
const { opciones = '', franjas = '', boton = 'Pedir cita', class: clase = '' } = Astro.props;
const email = site.contacto.email;
const asunto = `Cita desde la web de ${site.nombre}`;
const accion = email ? `mailto:${email}?subject=${encodeURIComponent(asunto)}` : '';
const partir = (t: string) => String(t ?? '').split(/\s*[;\n]\s*/).map((x) => x.trim()).filter(Boolean);
const tratamientos = partir(opciones);
const horas = partir(franjas);
---

<form class:list={['formulario', clase]} action={accion || undefined} method="post" enctype="text/plain">
  <div class="grid gap-4 sm:grid-cols-2">
    <div class="campo">
      <label for="cita-nombre">Nombre y apellidos</label>
      <input id="cita-nombre" name="nombre" type="text" autocomplete="name" required />
    </div>
    <div class="campo">
      <label for="cita-contacto">Teléfono o email</label>
      <input id="cita-contacto" name="contacto" type="text" autocomplete="tel" required />
    </div>
  </div>
  <div class="campo">
    <label for="cita-tratamiento">¿Qué necesitas?</label>
    {
      tratamientos.length > 0 ? (
        <select id="cita-tratamiento" name="tratamiento" required>
          <option value="">Elige un tratamiento</option>
          {tratamientos.map((e) => <option value={e}>{e}</option>)}
        </select>
      ) : (
        <input id="cita-tratamiento" name="tratamiento" type="text" required />
      )
    }
  </div>
  {
    horas.length > 0 && (
      <fieldset class="franjas">
        <legend class="w-full">¿Cuándo te viene mejor?</legend>
        {horas.map((h, i) => (
          <label class="franja">
            <input type="radio" name="franja" value={h} required={i === 0} />
            <span>{h}</span>
          </label>
        ))}
      </fieldset>
    )
  }
  <div class="campo">
    <label for="cita-mensaje">Cuéntanos algo más (opcional)</label>
    <textarea id="cita-mensaje" name="mensaje" rows="3"></textarea>
  </div>
  <label class="campo-check">
    <input type="checkbox" name="privacidad" required />
    <span>He leído el <a href="/aviso-legal">aviso legal y la política de privacidad</a>.</span>
  </label>
  <button type="submit" class="btn">{boton}</button>
  <p class="formulario-aviso">
    {
      email
        ? 'Al enviar se abre tu programa de correo con la petición lista.'
        : 'Formulario de muestra: todavía no envía mensajes. Usa el teléfono o el email de contacto.'
    }
  </p>
</form>
